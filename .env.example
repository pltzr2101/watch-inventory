# Watch-Inventory – Umgebungsvorlage (keine echten Secrets eintragen!)
# =====================================================================
# Kopie anlegen:  cp .env.example .env    (die .env liegt NICHT im Repository)
# Für Portainer:  Werte in den Stack "Environment variables" eintragen
# (siehe docs/INSTALL.md).

# ---------------------------------------------------------------- Stack/Variablen
# Registry-Image (kein build:). Eigener Pfad vor dem Push anpassen:
IMAGE=ghcr.io/beispiel/watch-inventory
# Versionierter Tag – für Produktion keinen "latest" verwenden:
TAG=0.1.0
# Host-Port (3000 ist auf dem Ziel-LXC belegt; Standard 3080):
HOST_PORT=3080

# ---------------------------------------------------------------- Secrets (Pflicht)
# Session-Secret (mind. 32 Zeichen), erzeugen mit:
#   openssl rand -hex 32
SESSION_SECRET=

# Argon2-Hash des Admin-Logins, erzeugen mit (im Repo/venv):
#   python -m app.security 'mein-passwort'
# Die App bricht ohne diesen Wert mit klarer Fehlermeldung ab.
ADMIN_PASSWORD_HASH=

# ---------------------------------------------------------------- App
# Datenverzeichnis im Container (entspricht dem Volume-Mount):
DATA_DIR=/data
# Nur hinter HTTPS/Reverse Proxy auf true setzen:
COOKIE_SECURE=false
# Login-Rate-Limit:
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SECONDS=300
# Upload-Limits:
MAX_UPLOAD_MB=15
MAX_IMAGE_PIXELS=40000000
# Ggf. angepasste Anzeigen-Vorlagen (z. B. für Plattform-Hinweise):
# LISTING_TEMPLATE_DIR=/data/listing_templates

# ---------------------------------------------------------------- Wecatalog.cn
# Integration standardmäßig deaktiviert. Vor Aktivierung zwingend
# docs/WEBCATALOG.md lesen (Umfang der Einverständniserklärung, API-Endpunkt).
WECATALOG_ENABLED=false
WECATALOG_BASE_URL=https://www.wecatalog.cn
# Offizieller, vom Betreiber bereitgestellter API-/Export-Endpunkt (Pflicht
# bei Aktivierung; leer lassen, solange deaktiviert):
WECATALOG_API_URL=
# Nur, wenn der Betreiber einen autorisierten Zugang bereitstellt (sonst leer):
WECATALOG_API_TOKEN=
WECATALOG_TIMEOUT_SECONDS=10
WECATALOG_MAX_FETCHES_PER_HOUR=6
# Katalogbilder unverändert behandeln, solange der Erlaubnisumfang für
# Bearbeitungen nicht eindeutig geklärt ist (Standard false = unverändert):
WECATALOG_ALLOW_IMAGE_EDIT=false

# ---------------------------------------------------------------- Registry-Login
# Registry-Zugangsdaten NICHT hier ablegen. In Portainer unter
# Stack → Environment → "Registry authentication" (bzw. beim Stack-Create
# "Registry credentials") hinterlegen; siehe docs/INSTALL.md.
