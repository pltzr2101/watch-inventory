# Watch-Inventory – Umgebungsvorlage (keine echten Secrets eintragen!)
# =====================================================================
# Kopie anlegen:  cp .env.example .env    (die .env liegt NICHT im Repository)
# Für Portainer:  Werte in den Stack "Environment variables" eintragen
# (siehe docs/INSTALL.md).

# ---------------------------------------------------------------- Stack/Variablen
# Registry-Image (kein build:). Default = eigener GHCR-Pfad (das
# docker-publish-Workflow pusht nach jedem main-Push/V*-Tag hierhin):
IMAGE=ghcr.io/pltzr2101/watch-inventory
# Image-Tag: Standard "latest" (Watchtower holt neue automatisch).
# Für festen/reproduzierbaren Stand z. B. "0.1.0" eintragen –
# Versionstage erzeugt das Workflow automatisch aus git-Tags "vX.Y.Z".
TAG=latest
# Host-Port (3000 ist auf dem Ziel-LXC belegt; Standard 3080):
HOST_PORT=3080

# ---------------------------------------------------------------- Secrets (Pflicht)
# Session-Secret (mind. 32 Zeichen), erzeugen mit:
#   openssl rand -hex 32
SESSION_SECRET=

# Admin-Login – empfohlen: normales Passwort (so wie bei Grafana, Portainer
# & Co.). Die App hasht es beim Start selbst (Argon2, nur im Speicher).
ADMIN_PASSWORD=
# Alternative (Härtung): fertiger Argon2-Hash, erzeugen mit
#   python -m app.security 'mein-passwort'
# ACHTUNG: $-Zeichen werden in der compose-YAML als Variablen gelesen –
# den Hash NIE direkt in die YAML schreiben, sondern nur in die
# Stack-Variablen (bzw. dort jedes $ als $$ eintragen).
ADMIN_PASSWORD_HASH=

# ---------------------------------------------------------------- App
# Datenverzeichnis im Container (entspricht dem Volume-Mount):
DATA_DIR=/data
# Nur hinter HTTPS/Reverse Proxy auf true setzen:
COOKIE_SECURE=false
# Login-Rate-Limit:
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SECONDS=300
# Upload-Limits:
MAX_UPLOAD_MB=15
# 80 MP – ausreichend für 48-MP-iPhone-Fotos (HEIC/HEIF wird akzeptiert):
MAX_IMAGE_PIXELS=80000000
# Ggf. angepasste Anzeigen-Vorlagen (z. B. für Plattform-Hinweise):
# LISTING_TEMPLATE_DIR=/data/listing_templates

# ---------------------------------------------------------------- Wecatalog.cn
# Integration standardmäßig deaktiviert. Vor Aktivierung zwingend
# docs/WEBCATALOG.md lesen (Umfang der Einverständniserklärung, API-Endpunkt).
WECATALOG_ENABLED=false
WECATALOG_BASE_URL=https://www.wecatalog.cn
# Offizieller, vom Betreiber bereitgestellter API-/Export-Endpunkt (Pflicht
# bei Aktivierung; leer lassen, solange deaktiviert):
WECATALOG_API_URL=
# Nur, wenn der Betreiber einen autorisierten Zugang bereitstellt (sonst leer):
WECATALOG_API_TOKEN=
WECATALOG_TIMEOUT_SECONDS=10
WECATALOG_MAX_FETCHES_PER_HOUR=6
# Katalogbilder unverändert behandeln, solange der Erlaubnisumfang für
# Bearbeitungen nicht eindeutig geklärt ist (Standard false = unverändert):
WECATALOG_ALLOW_IMAGE_EDIT=false

# ---------------------------------------------------------------- Registry-Login
# Registry-Zugangsdaten NICHT hier ablegen. In Portainer unter
# Stack → Environment → "Registry authentication" (bzw. beim Stack-Create
# "Registry credentials") hinterlegen; siehe docs/INSTALL.md.

# ---------------------------------------------------------------------------
# USD→EUR-Kursdienst für das Einkaufsformular (V2)
# Wird NUR auf Klick von „Aktuellen Kurs holen" abgefragt; der eingetragene
# Kurs wird historisch gespeichert. Leer lassen = deaktiviert (manuelle Eingabe).
FX_RATE_URL=https://api.frankfurter.dev/v1/latest?from=USD&to=EUR
# Benutzername für den Login (KEIN Secret; Passwort weiterhin ADMIN_PASSWORD[_HASH])
APP_USERNAME=admin
